{
  "name": "paypay",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.11.0",
  "workspaces": [
    "apps/frontend",
    "apps/bff",
    "packages/sdk"
  ],
  "engines": {
    "node": "22.14.x",
    "pnpm": ">=9"
  },
  "engineStrict": true,
